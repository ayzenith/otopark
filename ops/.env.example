# ---------------------------------------------------------------------------
# ops/.env - sunucu dagitimi ortam degiskenleri
# Bu dosyayi ops/.env olarak kopyalayip doldurun. .env ASLA depoya girmez.
# ---------------------------------------------------------------------------

# Veritabani
POSTGRES_USER=otopark
POSTGRES_DB=otopark
# Guclu bir parola uretin:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Oturum imzalama sirri:  openssl rand -base64 32
AUTH_SECRET=

# Uygulamanin herkese acik adresi
# Alan adi (karar 11.10.2026): londracampingtandircioglu.com
# www kaydi ayni IP'ye bakiyorsa Caddy www -> kok yonlendirmesini yapar.
AUTH_URL=https://londracampingtandircioglu.com
SITE_ADDRESS=londracampingtandircioglu.com

# Yedeklerin sifrelenmesi icin parola:  openssl rand -base64 24
# BOS BIRAKMAYIN - sifrelenmemis yedek, sunucu disina cikarildiginda risktir.
BACKUP_PASSPHRASE=

# ---------------------------------------------------------------------------
# Ilk kurulumda (yalnizca bir kez) patron hesabi icin:
#   docker compose run --rm app npx prisma db seed
# OWNER_INITIAL_PASSWORD'u BOS BIRAKIN: seed guvenli bir parola uretir ve
# yalnizca terminal ekranina bir kez yazar.
# ---------------------------------------------------------------------------
OWNER_USERNAME=patron
OWNER_FULLNAME=İşletme Sahibi
OWNER_INITIAL_PASSWORD=
