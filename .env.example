# ---------------------------------------------------------------------------
# Londra Camping Otopark - ortam degiskenleri ornegi
# Bu dosyayi .env olarak kopyalayin ve degerleri doldurun.
# .env dosyasi ASLA depoya gonderilmez (.gitignore'da).
# ---------------------------------------------------------------------------

# PostgreSQL baglantisi
DATABASE_URL="postgresql://KULLANICI:PAROLA@localhost:5432/otopark?schema=public"

# Testler icin ayri veritabani (entegrasyon testleri bu veritabanini siler/yeniden kurar)
DATABASE_URL_TEST="postgresql://KULLANICI:PAROLA@localhost:5432/otopark_test?schema=public"

# Oturum imzalama sirri. Uretmek icin:  openssl rand -base64 32
AUTH_SECRET=""

# Uygulamanin calistigi adres
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# ILK PATRON HESABI (yalnizca ilk kurulumda, seed icin)
# ---------------------------------------------------------------------------
# Kullanici adi. Bos birakilirsa "patron" kullanilir.
OWNER_USERNAME="patron"
OWNER_FULLNAME="Isletme Sahibi"

# Baslangic parolasi. BOS BIRAKIN: seed guvenli bir rastgele parola uretir ve
# yalnizca terminal ekranina bir kez yazar. Parolayi buraya yazarsaniz dosyada
# acik metin olarak kalir - onerilmez.
OWNER_INITIAL_PASSWORD=""
